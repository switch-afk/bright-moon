<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head", { title }) %>
</head>
<body class="min-h-screen bg-indigo-950 text-slate-200 flex items-center justify-center p-6">
  <main class="max-w-xl text-center">
    <div class="mx-auto mb-8 size-24 rounded-full bg-slate-100 shadow-[0_0_60px_rgba(226,232,240,0.35)]"></div>
    <h1 class="text-5xl font-semibold tracking-tight text-white"><%= title %></h1>
    <p class="mt-4 text-lg text-slate-400">
      Express, EJS and Tailwind are up and running.
    </p>
    <form action="/logout" method="POST" class="mt-10">
      <button type="submit" class="rounded-lg border border-slate-600 px-4 py-2 text-sm text-slate-300 hover:border-slate-400 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-200">
        Sign out
      </button>
    </form>
  </main>
</body>
</html>